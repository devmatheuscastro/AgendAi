# Copie para .env e preencha a senha do usuário PostgreSQL.
# Variáveis já definidas no sistema têm prioridade.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agendai
DB_USER=agendai
DB_PASSWORD=troque_esta_senha
DB_SSLMODE=prefer

# Alternativa: DATABASE_URL tem prioridade sobre DB_*.
# Caracteres especiais na URL precisam de percent-encoding.
# DATABASE_URL=postgresql://agendai:senha@127.0.0.1:5432/agendai
